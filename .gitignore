/.idea/
/.venv/
/work/
/results/
/blog/
__pycache__/
# The aggregate results/<run_id>/ CSV + analysis stay LOCAL (gitignored here).
# Each chain's results are committed onto its evolve/<strategy>/<arm>/chain<n>/<run_id>
# branch in the arm repo instead, so every branch is a self-contained record.
/results-backup-*/
# Build outputs of paper/build.sh. Every one of them is derivable from
# main.tex and figures/, which are tracked, so committing them would only add
# binaries that churn on each rebuild. That was already the rule for
# arxiv.tar.gz; main.pdf now follows it.
/paper/arxiv.tar.gz
/paper/main.pdf
# The plain-text abstract, for pasting into the arXiv and Zenodo forms. Written
# by build.sh out of main.tex's abstract environment, so it is derived like the
# two above and is gitignored for the same reason: the hand-maintained copy
# drifted from the paper.
/paper/abstract.txt
# The aux files pdflatex leaves next to main.tex. Tectonic never did, because
# it compiles in a temp dir, so these only started appearing once pdflatex was
# the engine in use.
/paper/main.aux
/paper/main.log
/paper/main.out
/paper/main.toc
